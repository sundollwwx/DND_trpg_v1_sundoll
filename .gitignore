*.py[cod]

# IDE-local settings
.idea/
.vscode/
.tools/
/cloudflared
/cloudflared.exe

# Runtime and temporary files
*.log
*.tmp
*.temp
~$*

# The public repository contains source and explicit public assets only.

# Regenerable multiplayer map/avatar cache.
.sundoll-cache/
音乐缓存/

# Player login credentials are machine-private; reset after moving hosts.
**/存档/玩家档案/认证/

# OS-held server lock (not campaign data)
**/存档/.server.lock

# Machine-specific tunnel binaries live with the engine.
/程序包/主程序/bin/cloudflared
/程序包/主程序/bin/cloudflared.exe

